/*
---------- App ---------- 
*/

Screen {
    layout: horizontal;
}

#existing_colours {
    background: white 20%;
    height: 1fr;
    border: #BFBFBF;
}

#existing_palettes {
    dock: left;
    height: 100%;
    width: 20;
    background: white 20%;
    border: #BFBFBF;
}


.viz_labels {
    width: 100%;
    height: 1fr;
    color: white;
    text-style: bold;
}

/*
---------- Add palette ----------
*/

AddPalette {
    layout: vertical;
    align: center middle;
}

.add_palette {
    width: 50%;
    text-align: center;
    padding: 1;
}

#palette_name {
    border: solid #BFBFBF;
    width: 50%;
    background: white 0%;
}

/*
---------- Generate palette ----------
*/

GeneratePalette {
    layout: vertical;
    align: center middle;
}

#gen_controls {
    height: auto;
    width: 100%;
    align: center middle;
}

#gen_controls Select, #gen_controls Input {
    width: 20;
    margin: 1 1;
    border: solid #BFBFBF;
    background: white 0%;
}

#gen_presets {
    height: 8;
    width: 60%;
    background: white 20%;
    border: #BFBFBF;
}

#swatch_row {
    layout: horizontal;
    height: 1fr;
    width: 100%;
}

Swatch {
    width: 1fr;
    height: 100%;
    content-align: center middle;
    text-align: center;
    text-style: bold;
    border: tall transparent;
}

Swatch.-locked {
    border: thick white;
}

#gen_buttons {
    height: auto;
    width: 100%;
    align: center middle;
}

#gen_regen, #gen_save {
    margin: 1 1;
}

#gen_status {
    width: 100%;
    text-align: center;
    color: red;
}
